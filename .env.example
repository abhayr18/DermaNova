# ================================================================
# DermaNova Cloud Configuration (Supabase & Health-Tech SaaS)
# ================================================================

# Environment & Server
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="DermaNova Clinical AI"

# ----------------------------------------------------------------
# 1. Supabase Cloud Database (PostgreSQL)
# ----------------------------------------------------------------
# Obtain from: Supabase Project Dashboard -> Settings -> Database -> Connection String (URI / Session Mode)
# Example: postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./dermanova_clinical.db

# ----------------------------------------------------------------
# 2. Supabase Storage & API Keys
# ----------------------------------------------------------------
# Obtain from: Supabase Project Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Supabase Storage Buckets (Create these in Supabase Dashboard -> Storage)
STORAGE_BUCKET_SCANS=patient-scans
STORAGE_BUCKET_HEATMAPS=diagnostic-heatmaps

# ----------------------------------------------------------------
# 3. Application Security (JWT Tokens)
# ----------------------------------------------------------------
JWT_SECRET_KEY=generate-a-secure-random-64-character-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----------------------------------------------------------------
# 4. Frontend Client Environment (.env.local for Next.js)
# ----------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
