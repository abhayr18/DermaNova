# ================================================================
# DermaNova Cloud Configuration (FastAPI, PyTorch & Supabase)
# ================================================================

# Environment & Server
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="DermaNova Clinical AI"

# ----------------------------------------------------------------
# 1. Cloud Database (PostgreSQL / Supabase / SQLite Local Fallback)
# ----------------------------------------------------------------
# For production (Supabase / RDS):
# DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# For local offline development:
DATABASE_URL=sqlite:///./dermanova_clinical.db

# ----------------------------------------------------------------
# 2. Supabase Storage & API Keys
# ----------------------------------------------------------------
# Obtain from: Supabase Project Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Supabase Storage Buckets
STORAGE_BUCKET_SCANS=patient-scans
STORAGE_BUCKET_HEATMAPS=diagnostic-heatmaps
RETAIN_IMAGES_ENABLED=true

# ----------------------------------------------------------------
# 3. Application Security (JWT Tokens)
# ----------------------------------------------------------------
JWT_SECRET_KEY=generate-a-secure-random-64-character-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----------------------------------------------------------------
# 4. ML Model & Upload Configuration
# ----------------------------------------------------------------
INFERENCE_DEVICE=auto                    # 'auto', 'cpu', or 'cuda'
MAX_UPLOAD_SIZE_BYTES=5242880            # 5MB maximum upload limit
PREDICTION_THRESHOLD=0.38                # Calibrated positive finding threshold
MODEL_CHECKPOINT_PATH=                   # Optional custom path to .pth checkpoint

# ----------------------------------------------------------------
# 5. CORS Allowed Origins (Comma-separated for production)
# ----------------------------------------------------------------
ALLOWED_ORIGINS=https://dermanova.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------------------
# 6. Frontend Client Environment (.env.local for Next.js)
# ----------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
